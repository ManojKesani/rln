# S-001: Documents every env var
# Imports: (none)
# Exports: DATABASE_URL, REDIS_URL, POSTGRES_*, PHOENIX_*

# .env.example  (copy to .env and never commit .env)

# ---------- S-001: stack ----------
POSTGRES_USER=trillian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trillian

# Inside Compose the hosts are the service names (postgres, redis, phoenix).
# asyncpg needs a plain postgresql:// URL, not postgresql+asyncpg://
DATABASE_URL=postgresql://trillian:change-me@postgres:5432/trillian
REDIS_URL=redis://redis:6379/0

APP_ENV=dev
APP_VERSION=0.1.0

# ---------- S-003: tracing ----------
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
PHOENIX_PROJECT_NAME=trillian

# ---------- S-002: login (uncomment when you build it) ----------
# AUTH_USERNAME=admin
# Generate with: uv run python scripts/hash_password.py
# AUTH_PASSWORD_HASH='$2b$12$...'
# JWT_SECRET=generate-a-long-random-string
# COOKIE_NAME=trillian_session

# ---------- S-004: providers (leave blank to mark a provider unavailable) ----------
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=